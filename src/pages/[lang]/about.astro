---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { localize } from '@/i18n/ui';
import type { Language } from '@/types';
import aboutContent from '@/content/about.json';

export function getStaticPaths() { return [{ params: { lang: 'en' } }, { params: { lang: 'uk' } }]; }
const lang = Astro.params.lang as Language;

const title = localize(aboutContent.title, lang);
const body = localize(aboutContent.body, lang);
const addressLabel = localize(aboutContent.address.label, lang);
const addressOrganization = localize(aboutContent.address.organization, lang);
const addressStreet = localize(aboutContent.address.street, lang);
---
<BaseLayout title={title} lang={lang}>
  <section class="section page-intro narrow">
    <h1>{title}</h1>
    <p>{body}</p>
    <address class="note-box shelter-address">
      <strong>{addressLabel}</strong>
      <span>{addressOrganization}</span>
      <span>{addressStreet}</span>
    </address>
  </section>
</BaseLayout>
