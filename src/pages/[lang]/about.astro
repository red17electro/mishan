---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { t } from '@/i18n/ui';
import type { Language } from '@/types';
export function getStaticPaths() { return [{ params: { lang: 'en' } }, { params: { lang: 'uk' } }]; }
const lang = Astro.params.lang as Language;
---
<BaseLayout title={t(lang, 'aboutTitle')} lang={lang}>
  <section class="section page-intro narrow">
    <p class="eyebrow">Mishan</p>
    <h1>{t(lang, 'aboutTitle')}</h1>
    <p>{t(lang, 'aboutText')}</p>
    <div class="note-box">
      <strong>Safety note</strong>
      <p>Do not publish exact shelter locations, evacuation details, or private volunteer phone numbers without explicit consent.</p>
    </div>
  </section>
</BaseLayout>
