---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PetCatalog from '@/components/PetCatalog.astro';
import { pets } from '@/lib/data';
import { t } from '@/i18n/ui';
import type { Language } from '@/types';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'uk' } }];
}
const lang = Astro.params.lang as Language;
---
<BaseLayout title={t(lang, 'allPets')} lang={lang}>
  <section class="section page-intro">
    <p class="eyebrow">Mishan</p>
    <h1>{t(lang, 'allPets')}</h1>
    <p>{t(lang, 'heroText')}</p>
  </section>
  <section class="section section--tight">
    <PetCatalog pets={pets} lang={lang} />
  </section>
</BaseLayout>
