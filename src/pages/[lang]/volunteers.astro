---
import BaseLayout from '@/layouts/BaseLayout.astro';
import VolunteerCard from '@/components/VolunteerCard.astro';
import { volunteers } from '@/lib/data';
import { t } from '@/i18n/ui';
import type { Language } from '@/types';
export function getStaticPaths() { return [{ params: { lang: 'en' } }, { params: { lang: 'uk' } }]; }
const lang = Astro.params.lang as Language;
---
<BaseLayout title={t(lang, 'volunteersTitle')} lang={lang}>
  <section class="section page-intro">
    <p class="eyebrow">Mishan</p>
    <h1>{t(lang, 'volunteersTitle')}</h1>
    <p>{t(lang, 'volunteersText')}</p>
  </section>
  <section class="section section--tight card-grid">
    {volunteers.map((volunteer) => <VolunteerCard volunteer={volunteer} lang={lang} />)}
  </section>
</BaseLayout>
