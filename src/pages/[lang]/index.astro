---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PetCard from '@/components/PetCard.astro';
import { DEFAULT_PET_PHOTO, heroPet, isAdoptablePet, pets, resolvePetPhotos } from '@/lib/data';
import { localize, t } from '@/i18n/ui';
import type { Language } from '@/types';

export function getStaticPaths() {
  return [{ params: { lang: 'en' } }, { params: { lang: 'uk' } }];
}
const lang = Astro.params.lang as Language;
const featuredPets = pets.filter((pet) => pet.featured && isAdoptablePet(pet)).slice(0, 3);
const heroPhoto = heroPet ? resolvePetPhotos(heroPet.photos)[0] : DEFAULT_PET_PHOTO;
const heroAlt = heroPet ? localize(heroPet.name, lang) : 'Mishan shelter pet';
---
<BaseLayout title={t(lang, 'navHome')} lang={lang} description={t(lang, 'heroText')}>
  <section class="hero section">
    <div class="hero__content">
      <p class="eyebrow">{t(lang, 'tagline')}</p>
      <h1>{t(lang, 'heroTitle')}</h1>
      <p>{t(lang, 'heroText')}</p>
      <div class="button-row">
        <a class="button button--primary" href={`/${lang}/pets`}>{t(lang, 'adoptPet')}</a>
        <a class="button button--secondary" href={`/${lang}/donate`}>{t(lang, 'donate')}</a>
      </div>
    </div>
    <div class="hero__card">
      {heroPet ? (
        <a class="hero__card-link" href={`/${lang}/pets/${heroPet.slug}`}>
          <img src={heroPhoto} alt="" />
          <span class="hero__pet-name">{localize(heroPet.name, lang)}</span>
        </a>
      ) : (
        <img src={heroPhoto} alt={heroAlt} />
      )}
    </div>
  </section>

  <section class="section">
    <div class="section-heading">
      <p class="eyebrow">{t(lang, 'siteName')}</p>
      <h2>{t(lang, 'featuredPets')}</h2>
      <a class="text-link" href={`/${lang}/pets`}>{t(lang, 'allPets')} →</a>
    </div>
    <div class="pet-grid">
      {featuredPets.map((pet) => <PetCard pet={pet} lang={lang} />)}
    </div>
  </section>
</BaseLayout>
