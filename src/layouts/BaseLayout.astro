---
import SocialLinks from '@/components/SocialLinks.astro';
import type { Language } from '@/types';
import { defaultLang, languages, t } from '@/i18n/ui';
import { absoluteUrl, DEFAULT_OG_IMAGE, localizedPath, ogLocale, resolveSite } from '@/lib/seo';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang: Language;
  image?: string;
  structuredData?: object[];
}

const {
  title,
  description = 'Mishan animal shelter website',
  lang,
  image = DEFAULT_OG_IMAGE,
  structuredData = []
} = Astro.props;

const nav = [
  { href: `/${lang}`, label: t(lang, 'navHome') },
  { href: `/${lang}/pets`, label: t(lang, 'navPets') },
  { href: `/${lang}/donate`, label: t(lang, 'navDonate') },
  { href: `/${lang}/contacts`, label: t(lang, 'navVolunteers') },
  { href: `/${lang}/about`, label: t(lang, 'navAbout') }
];
const currentPath = Astro.url.pathname;
function switchPath(targetLang: Language) {
  return localizedPath(currentPath, targetLang);
}

const site = resolveSite(Astro.site);
const pageTitle = `${title} · ${t(lang, 'siteName')}`;
const canonicalUrl = absoluteUrl(site, currentPath);
const imageUrl = absoluteUrl(site, image);
const otherLang: Language = lang === 'en' ? 'uk' : 'en';
const hreflangLinks = (Object.keys(languages) as Language[]).map((code) => ({
  code,
  href: absoluteUrl(site, localizedPath(currentPath, code))
}));
const defaultHreflangHref = absoluteUrl(site, localizedPath(currentPath, defaultLang));
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-72YXE9KTK6"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-72YXE9KTK6');
    </script>
    <meta name="description" content={description} />
    <title>{pageTitle}</title>
    <link rel="canonical" href={canonicalUrl} />
    {hreflangLinks.map((entry) => <link rel="alternate" hreflang={entry.code} href={entry.href} />)}
    <link rel="alternate" hreflang="x-default" href={defaultHreflangHref} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:site_name" content={t(lang, 'siteName')} />
    <meta property="og:locale" content={ogLocale(lang)} />
    <meta property="og:locale:alternate" content={ogLocale(otherLang)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {structuredData.map((entry) => <script type="application/ld+json" set:html={JSON.stringify(entry)} is:inline />)}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-latin-wght-normal.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-cyrillic-wght-normal.woff2" crossorigin />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={`/${lang}`} aria-label="Mishan home">
        <span class="brand-mark">🐾</span>
        <span>
          <strong>{t(lang, 'siteName')}</strong>
          <small>{t(lang, 'tagline')}</small>
        </span>
      </a>
      <nav class="main-nav" aria-label="Main navigation">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <div class="header-actions">
        <a
          class="admin-link"
          href="https://app.pagescms.org"
          target="_blank"
          rel="noopener noreferrer"
        >
          {t(lang, 'navAdmin')}
        </a>
        <div class="language-switch" aria-label={t(lang, 'language')}>
          {(Object.keys(languages) as Language[]).map((code) => (
            <a class={code === lang ? 'active' : ''} href={switchPath(code)}>{code.toUpperCase()}</a>
          ))}
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <SocialLinks lang={lang} variant="footer" />
      <p class="muted">
        {t(lang, 'footerCreditBefore')} · <a href="https://github.com/red17electro" style="color:inherit">{t(lang, 'footerCreditName')}</a>{t(lang, 'footerCreditAfter')}
      </p>
    </footer>
  </body>
</html>
