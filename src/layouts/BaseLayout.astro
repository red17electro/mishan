---
import SocialLinks from '@/components/SocialLinks.astro';
import type { Language } from '@/types';
import { languages, t } from '@/i18n/ui';
import '@/styles/global.css';

interface Props {
  title: string;
  description?: string;
  lang: Language;
}

const { title, description = 'Mishan animal shelter website', lang } = Astro.props;
const nav = [
  { href: `/${lang}`, label: t(lang, 'navHome') },
  { href: `/${lang}/pets`, label: t(lang, 'navPets') },
  { href: `/${lang}/donate`, label: t(lang, 'navDonate') },
  { href: `/${lang}/contacts`, label: t(lang, 'navVolunteers') },
  { href: `/${lang}/about`, label: t(lang, 'navAbout') }
];
const currentPath = Astro.url.pathname;
function switchPath(targetLang: Language) {
  return currentPath.replace(/^\/(en|uk)(?=\/|$)/, `/${targetLang}`) || `/${targetLang}`;
}
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-72YXE9KTK6"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag('js', new Date());
      gtag('config', 'G-72YXE9KTK6');
    </script>
    <meta name="description" content={description} />
    <title>{title} · {t(lang, 'siteName')}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-latin-wght-normal.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter-cyrillic-wght-normal.woff2" crossorigin />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={`/${lang}`} aria-label="Mishan home">
        <span class="brand-mark">🐾</span>
        <span>
          <strong>{t(lang, 'siteName')}</strong>
          <small>{t(lang, 'tagline')}</small>
        </span>
      </a>
      <nav class="main-nav" aria-label="Main navigation">
        {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <div class="header-actions">
        <a
          class="admin-link"
          href="https://app.pagescms.org"
          target="_blank"
          rel="noopener noreferrer"
        >
          {t(lang, 'navAdmin')}
        </a>
        <div class="language-switch" aria-label={t(lang, 'language')}>
          {(Object.keys(languages) as Language[]).map((code) => (
            <a class={code === lang ? 'active' : ''} href={switchPath(code)}>{code.toUpperCase()}</a>
          ))}
        </div>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <SocialLinks lang={lang} variant="footer" />
      <p class="muted">
        {t(lang, 'footerCreditBefore')} · <a href="https://github.com/red17electro" style="color:inherit">{t(lang, 'footerCreditName')}</a>{t(lang, 'footerCreditAfter')}
      </p>
    </footer>
  </body>
</html>
