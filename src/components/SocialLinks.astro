---
import {
  getActiveSocialLinks,
  isExternalSocialHref,
  type SocialLink
} from '@/config/socialLinks';
import { t } from '@/i18n/ui';
import type { Language } from '@/types';

interface Props {
  lang: Language;
  variant?: 'footer';
}

const { lang, variant = 'footer' } = Astro.props;
const activeLinks = getActiveSocialLinks();

function linkLabel(link: SocialLink): string {
  return link.labelKey ? t(lang, link.labelKey) : link.label;
}
---

{
  activeLinks.length > 0 && (
    <nav
      class:list={['social-links', `social-links--${variant}`]}
      aria-label={t(lang, 'socialLinksLabel')}
    >
      <ul class="social-links__list">
        {activeLinks.map((link) => {
          const external = isExternalSocialHref(link.href);

          return (
            <li>
              <a
                class="social-link"
                href={link.href}
                {...(external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                aria-label={linkLabel(link)}
              >
                <span
                  class="social-link__icon"
                  style={`--social-icon: url(${link.iconPath})`}
                  aria-hidden="true"
                />
              </a>
            </li>
          );
        })}
      </ul>
    </nav>
  )
}
